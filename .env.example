# ==================== doqa ====================
# Базовый URL инстанса doqa (без завершающего слэша)
DOQA_BASE_URL=https://doqa.example.com
# API-ключ (используется как Authorization: Bearer <ключ>)
DOQA_API_KEY=your-doqa-api-key
# Либо basic-auth вместо ключа (если API-ключ не используется):
DOQA_USERNAME=
DOQA_PASSWORD=
# Таймаут HTTP-запросов, сек
HTTP_TIMEOUT=120
# Проверка TLS-сертификата (false для self-signed в корпоративной сети)
VERIFY_SSL=true

# ==================== OpenAI / LLM ====================
OPENAI_API_KEY=sk-your-openai-key
# Необязательно: кастомный/совместимый endpoint (Azure, local gateway, etc.)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=8000

# ==================== Настройки утилиты ====================
# Формат экспорта из doqa: xlsx | pdf
EXPORT_FORMAT=xlsx
# Каталог для результатов (выгрузка, чек-лист, сгенерированные кейсы, промпты)
OUTPUT_DIR=./output
